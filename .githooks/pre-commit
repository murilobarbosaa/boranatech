#!/bin/sh
# Pre-commit do Bora na Tech.
#
# Por que existe: durante a auditoria do Analisador de LinkedIn, duas vezes um
# commit saiu antes de alguem ler o resultado dos testes, e nas duas as golden
# files pegaram a quebra depois do fato. Um check que depende de lembrar de
# rodar e exatamente o desenho que causou o bug original desta auditoria (a
# migration que ficou no repositorio sem ser aplicada). Aqui roda sozinho.
#
# POR QUE A SUITE INTEIRA, E NAO UM SUBCONJUNTO. A primeira versao rodava so as
# golden files mais shared/linkedin, para economizar 5 segundos. Na Fase 2B um
# commit passou verde por esse hook com 10 testes vermelhos: um campo novo em
# LinkedinParsed quebrou linkedinFronteiras.test.ts, que estava fora da lista
# escrita a mao. Lista escrita a mao fica para tras da suite, e um check que
# fica para tras nao e check. 7,6s contra 1,3s e o preco de nao ter que confiar
# em manutencao manual do proprio guarda.
#
# POR QUE A SEGUNDA RODADA, SEM `.env`. Essa e a condicao real do CI: o job
# `qualidade` nao recebe segredo nenhum e nao existe arquivo `.env` la. Duas
# vezes seguidas um teste que le `env.*` passou local e quebrou no CI, e na
# segunda vez foi no commit IMEDIATAMENTE seguinte ao que documentou a
# armadilha. Documentacao nao impediu; execucao impediu. Ver CLAUDE.md, o item
# do `env -i`, e docs/harness-fidelidade-instrumento.md secao 2-bis.
#
# POR QUE A SUITE TODA DE NOVO, e nao so "os testes que importam env": a
# dependencia e TRANSITIVA. janelaDeDeployInversa.test.ts nao importa `./env`,
# importa `analyzeLinkedin`, que importa. Enumerar isso da fonte exige seguir o
# grafo de imports, ou seja, um parser que pode sub-casar em silencio, que e a
# classe de defeito que este hook existe para nao repetir. Rodar tudo duas vezes
# custa ~8s e nao depende de nenhum parser meu estar certo.
#
# Roda: suite (~7,6s) + suite sem .env (~7,6s) + pnpm check (~3,3s).
#
# ATENCAO: `pnpm check` NAO cobre arquivos de teste, porque tsconfig.json os
# exclui. Erro de tipo em teste so aparece quando o teste roda, e e por isso que
# rodar a suite aqui importa ainda mais.
#
# Emergencia: git commit --no-verify. Use com parcimonia e conserte depois.
#
# POR QUE A SEGUNDA RODADA NAO MEXE MAIS NO `.env`. A versao anterior renomeava o
# arquivo (`mv .env .env.pre-commit-bak`) e restaurava por `trap EXIT INT TERM`.
# A FIDELIDADE estava certa (ausencia do ARQUIVO, nao `env -i`); a DURABILIDADE,
# nao: `trap` nao roda em SIGKILL. Em 2026-07-28 um `kill -9` (OOM, duas suites em
# paralelo) matou o hook entre o `mv` e a restauracao. O `.env` sumiu do disco e a
# copia integral dos segredos ficou como untracked, a um `git add -A` de vazar.
#
# A correcao NAO troca fidelidade por conveniencia. Uma tentativa intermediaria
# so trocava o `cwd` da segunda rodada, e foi descartada por ser MEIO-CEGA: o
# `dotenv` resolve por `process.cwd()`, mas o Vite tem carregador proprio ancorado
# em `envDir`/`root`, entao `import.meta.env.VITE_*` continuava populado. Medido
# por probe. Enganar carregador por carregador so cobre os que alguem lembrou;
# remover a coisa em si derrota todos.
#
# O QUE FAZ AGORA: materializa o INDICE num diretorio temporario e roda a segunda
# passada la dentro, com `--root` apontando para ele.
#
#   - `git checkout-index -a --prefix=` e nao `git archive`/`write-tree`: le o
#     indice direto e NAO cria objeto nenhum no banco de objetos. `write-tree`
#     escreveria uma tree a cada commit, efeito colateral que um hook nao deve ter.
#   - o INDICE, e nao o HEAD: o hook roda antes do commit existir, entao testar o
#     HEAD daria veredito sobre a arvore anterior. E nao o working tree: o que vai
#     ser commitado e o que esta staged.
#   - `.env` e gitignored, logo nao esta no indice, logo nao existe no temporario.
#     Os DOIS carregadores ficam cegos: `cwd` e `root` apontam para um lugar sem
#     `.env`.
#
# NAO HA ESTADO A RESTAURAR. Sem `mv`, sem backup, sem `trap`: um SIGKILL custa um
# commit abortado e um diretorio orfao em /tmp, nunca um ambiente quebrado.
set -e

echo "[pre-commit] suite de testes..."
npx vitest run --silent

echo "[pre-commit] suite sem .env (condicao do CI)..."
REPO=$(git rev-parse --show-toplevel)
SEM_ENV=$(mktemp -d)
git checkout-index -a --prefix="$SEM_ENV/"

# Guardas de sanidade DO PROPRIO INSTRUMENTO. Sem elas, um temporario vazio ou um
# `.env` inesperado fariam a segunda rodada passar verde sobre a premissa errada,
# que e a classe de defeito que este hook existe para nao repetir.
if [ ! -f "$SEM_ENV/vitest.config.ts" ] || [ ! -f "$SEM_ENV/package.json" ]; then
  echo "[pre-commit] ERRO: o indice nao materializou em $SEM_ENV." >&2
  rm -rf "$SEM_ENV"; exit 1
fi
if [ -e "$SEM_ENV/.env" ]; then
  echo "[pre-commit] ERRO: $SEM_ENV tem .env; nao seria a condicao do CI." >&2
  rm -rf "$SEM_ENV"; exit 1
fi

ln -s "$REPO/node_modules" "$SEM_ENV/node_modules"
( cd "$SEM_ENV" && "$SEM_ENV/node_modules/.bin/vitest" run --root "$SEM_ENV" --silent )
rm -rf "$SEM_ENV"
echo "[pre-commit] segunda rodada feita sobre o INDICE, sem .env, e o .env do disco nao foi tocado."

echo "[pre-commit] pnpm check..."
pnpm check

echo "[pre-commit] ok"
