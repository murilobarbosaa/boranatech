# Servidor
PORT=3000
NODE_ENV=development
APP_PUBLIC_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:5173

# Frontend (público no bundle Vite)
# Estas chaves VITE_ podem ser expostas no navegador.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_AUTH_REDIRECT_PATH=/perfil
VITE_AUTH_GOOGLE_ENABLED=true
# Domínio canônico de produção (sem barra final). Fixa o redirect do OAuth para
# sempre voltar a este host. Em preview/local deixe vazio: usa a origin atual do
# navegador. Produção (Vercel): https://boranatech.com.br
VITE_SITE_URL=

# WhatsApp de suporte Pro (público no bundle). Formato E.164 sem "+" nem símbolos,
# ex: 556185852345. Vazio => o CTA de suporte não renderiza.
VITE_WHATSAPP_NUMBER=

# Login social via Supabase Auth
# Fluxo atual: SPA/client-side com detectSessionInUrl=true.
# O Supabase redireciona de volta para /perfil e o client detecta a sessão na URL.
#
# Supabase Dashboard > Authentication > URL Configuration
# Site URL:
# - https://boranatech.com.br
# Additional Redirect URLs:
# - http://localhost:3000/perfil
# - http://localhost:5173/perfil
# - https://boranatech.com.br/perfil
#
# Supabase Dashboard > Authentication > Sign In / Providers
# Ative Google e preencha Client ID / Client Secret vindos do Google Cloud.
#
# Google Cloud OAuth
# Authorized JavaScript origins:
# - http://localhost:3000
# - http://localhost:5173
# - https://boranatech.com.br
# Authorized redirect URI:
# - https://vlcvaanlkqyxemrxsxzn.supabase.co/auth/v1/callback

# IA
OPENAI_API_KEY=

# GitHub (analisador de portfolio)
# Opcional. Sem token: 60 req/h por IP. Com token: 5000 req/h.
# Use um token read-only, basta acesso a repos publicos.
GITHUB_TOKEN=

# Supabase - lado servidor (secreto; nunca usar prefixo VITE_)
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Somente backend/servidor. Nunca colocar como VITE_SUPABASE_SERVICE_ROLE_KEY.
SUPABASE_SERVICE_ROLE_KEY=

# Pagamento (Stripe, unico provider; segredos SO no backend, nunca com VITE_).
# Com BILLING_ENABLED=true o boot exige TODAS as vars abaixo (fail-closed).
# Em dev use SEMPRE chaves de TESTE; nunca use chave de producao em ambiente local.
# Chave de TESTE da Stripe (sk_test_...). Producao usa sk_live_ (so no Railway).
STRIPE_SECRET_KEY=
# Signing secret do webhook (whsec_...). Em dev vem do `stripe listen` (terminal);
# em producao vem do painel (Developers > Webhooks).
STRIPE_WEBHOOK_SECRET=
# price_ids do MODO TESTE em dev (gerados por `pnpm exec tsx scripts/stripe-setup.mjs`).
# Teste e producao tem price_ids DIFERENTES; rode o script uma vez por ambiente.
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_SEMIANNUAL=
STRIPE_PRICE_PRO_ANNUAL=
# Kill-switch do checkout. FAIL-CLOSED: so o literal exato "true" liga; ausente,
# vazio ou qualquer outro valor deixa o pagamento DESLIGADO (default seguro).
BILLING_ENABLED=

# Emissao de NFS-e. Mesmo desenho do BILLING_ENABLED: so o literal exato "true"
# liga; qualquer outra coisa deixa a emissao DESLIGADA.
NFSE_ENABLED=
# Adapter: "mock" (default, emite nota FALSA, so para dev), "focus_nfse"
# (municipal, o caminho de hoje) ou "focus_nfsen" (nacional, ainda scaffold: o
# boot RECUSA subir com ele). Valor desconhecido com NFSE_ENABLED=true derruba o
# boot, nunca cai no mock. O boot TAMBEM aborta com mock + NODE_ENV=production.
NFSE_PROVIDER=mock
# Token da Focus NFe (Basic auth: token como usuario, senha vazia).
NFSE_FOCUS_TOKEN=
# Ambiente da Focus: "homologacao" (default) ou "producao". O default NAO e
# producao de proposito: esquecer a env manda a nota para o sandbox, que e
# recuperavel, em vez de emitir documento fiscal de verdade sem querer.
NFSE_FOCUS_ENV=homologacao
# Dados do PRESTADOR (nos), do cadastro na prefeitura. Todos exigidos no boot
# quando NFSE_ENABLED=true e NFSE_PROVIDER=focus_nfse.
# Valor desta empresa: 67688579000106
NFSE_PRESTADOR_CNPJ=
# Valor desta empresa: <preencher> (consultar o cadastro na prefeitura)
NFSE_PRESTADOR_INSCRICAO_MUNICIPAL=
# Codigo IBGE do municipio do prestador (7 digitos).
# Valor desta empresa: 5300108 (Brasilia/DF)
NFSE_PRESTADOR_CODIGO_MUNICIPIO=
# ATENCAO: os dois abaixo vem do CONTADOR, nao de tentativa e erro. Item da
# lista de servicos (LC 116) e aliquota do ISS do municipio. Errar aqui NAO
# produz erro visivel: produz nota valida com imposto errado.
# Valores desta empresa: item 1.09, aliquota 2
NFSE_SERVICO_ITEM_LISTA=
NFSE_SERVICO_ALIQUOTA=
# Opcional: so alguns municipios exigem o codigo tributario proprio.
NFSE_SERVICO_CODIGO_TRIBUTARIO_MUNICIPIO=
# ENQUADRAMENTO TRIBUTARIO, tambem do contador.
#
# Obrigatoria com focus_nfse, e aceita EXATAMENTE "true" ou "false". Nao tem
# default: optante e nao-optante do Simples produzem tributacao diferente na
# mesma nota, e presumir um dos dois sairia como nota valida com imposto errado.
# Valor desta empresa: true
NFSE_OPTANTE_SIMPLES=
# Opcional; quando presente vai verbatim no payload.
# 1 = tributacao no municipio (ABRASF). Confirmar em homologacao.
NFSE_NATUREZA_OPERACAO=
# Opcional; quando presente vai verbatim no payload.
# 6 = ME/EPP optante do Simples (ABRASF). O ISSnet DF costuma rejeitar nota sem
# este campo (erro E166). Confirmar em homologacao.
NFSE_REGIME_ESPECIAL_TRIBUTACAO=
# Data de corte da emissao (YYYY-MM-DD). Cobranca anterior a ela NUNCA vira nota
# pela reconciliacao. VEM DO CONTADOR: e ele quem diz a partir de que competencia
# a empresa passa a emitir. NAO TEM DEFAULT e o boot ABORTA sem ela com
# NFSE_ENABLED=true, porque qualquer valor escolhido pelo codigo erraria nas duas
# direcoes (retroativo em mes ja fechado, ou nota faltando para quem pagou).
NFSE_EMITIR_DESDE=
# Teste manual do retry: "true" faz o adapter mock devolver falha RETENTAVEL.
NFSE_MOCK_FAIL=

# E-mail transacional e campanhas (Resend). Ausente: os envios viram no-op com
# warn, nada quebra.
RESEND_API_KEY=
# Secret de assinatura (Svix) do webhook do Resend. Ausente: o endpoint responde 503.
RESEND_WEBHOOK_SECRET=

# Redis das filas BullMQ (emails, email-campaign, fiscal-invoices). Ausente: os
# workers nao sobem; so os e-mails CRITICOS saem, por envio direto.
REDIS_URL=

# PostHog. ATENCAO: as chaves de server e client sao credenciais DIFERENTES.
# Server (Railway): leitura de analytics no admin via HogQL.
# POSTHOG_API_KEY e a Personal API Key (phx_...), leitura, com escopo de /query/.
POSTHOG_API_KEY=
# Id numerico do projeto no PostHog (Project settings).
POSTHOG_PROJECT_ID=
# Regiao/host da API. US: https://us.posthog.com  UE: https://eu.posthog.com
POSTHOG_HOST=https://us.posthog.com
# Client (Vercel): captura no navegador (posthog-js).
# VITE_POSTHOG_KEY e a chave PUBLICA de projeto (phc_...), captura, exposta ao browser.
VITE_POSTHOG_KEY=
# Host de captura (mesma regiao do projeto). US: https://us.i.posthog.com
VITE_POSTHOG_HOST=https://us.i.posthog.com

# Integrações externas (opcionais)
CURRENTS_API_KEY=
JOOBLE_API_KEY=
SYMPLA_API_KEY=

# Vagas multi-fonte (opcionais; vazias desligam a fonte no sync)
# Adzuna: app gratuito em https://developer.adzuna.com/
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# Token dedicado para ler os repos de vagas do GitHub. Opcional: sem ele o
# sync reusa o GITHUB_TOKEN acima; sem nenhum, roda em modo reduzido.
GITHUB_VAGAS_TOKEN=

# Voz do Natechinho nas entrevistas (ElevenLabs, opcional)
# Vazios desligam a feature: a rota de fala responde 503 tts_unavailable.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# Default: eleven_multilingual_v2
ELEVENLABS_MODEL_ID=
# Teto diario de geracoes de fala por usuario Pro (default 200)
INTERVIEW_TTS_DAILY_LIMIT_PRO=

# Capas de filmes e séries da seção Dicas (build-time, opcional).
# Sem ela, o build segue normal e a seção usa o fallback colorido.
# Rode: pnpm posters (grava o posterPath em client/src/lib/dicasPosters.generated.ts)
TMDB_API_KEY=

# Limites de IA - será usado no Prompt 4
AI_DAILY_LIMIT_FREE=5
AI_DAILY_LIMIT_PRO=50

# Moderação de avatar
# Numero de denunciantes distintos que escondem a foto automaticamente (pending_review).
# Ausente ou invalido cai no default 3.
AVATAR_REPORT_HIDE_THRESHOLD=3
# Score (0..1) a partir do qual a moderacao OpenAI bloqueia a imagem do avatar.
# Ausente ou invalido cai no default 0.5.
AVATAR_MODERATION_SCORE_THRESHOLD=0.5

# Custo de IA no admin: cotacao USD->BRL da linha SECUNDARIA do card.
# O numero PRINCIPAL e e continua em DOLAR, porque a tabela de precos dos
# modelos (MODEL_PRICING em server/lib/aiTools.ts) e cotada em US$ por 1 milhao
# de tokens. Ate 2026-08-14 o painel formatava esse valor como R$.
# OPCIONAL: ausente ou invalido NAO exibe a linha em BRL (nunca converte por 1).
AI_COST_USD_BRL_RATE=

# Cron
CRON_SECRET=

# Lista de espera / portao de lancamento
# WAITLIST_MODE: "gated" (default) mantem o portao fechado; "open" libera geral.
WAITLIST_MODE=gated
# Codigo de acesso beta. Se ausente, POST /api/beta/unlock sempre responde 401.
WAITLIST_ACCESS_CODE=
# Secret HMAC do token de beta. Se ausente, o portao nao emite token (sem crashar).
WAITLIST_TOKEN_SECRET=
# Secret HMAC do token de renovacao de boleto (link one-click do e-mail de
# lembrete). Se ausente, o endpoint de renovacao nega, sem crashar.
RENEWAL_TOKEN_SECRET=

# Dev-only: lista de user ids (uuid, separados por vírgula) que enxergam como Pro
# fora de produção, para testar features Pro localmente. Ignorada quando
# NODE_ENV=production. Somente backend/servidor; NUNCA prefixar com VITE_.
DEV_PRO_USER_IDS=

# Observabilidade (Sentry SDK, backend)
# DSN de ingestao de erros e tracing de rota. Ausente: Sentry.init vira no-op
# (sem captura nem tracing). Distinto do SENTRY_AUTH_TOKEN abaixo, que le issues.
SENTRY_DSN=
# Escape para reportar ao Sentry FORA de producao. Vazio ou qualquer coisa que
# nao seja "true": o SDK do servidor NAO inicializa quando NODE_ENV nao e
# production, mesmo com DSN presente. Existe porque ate 2026-08-31 nao havia
# guarda de ambiente e rodar `pnpm dev` com este arquivo preenchido mandava erro
# da maquina local para o projeto de PRODUCAO, virando card no CRM (dois cards
# vieram dai). Ligue so para exercitar o pipeline, numa sessao, e desligue: os
# eventos vao para o mesmo projeto de producao, marcados com o seu NODE_ENV.
SENTRY_ENABLE_NON_PROD=

# Observabilidade (Sentry SDK, browser/client)
# DSN publico do bundle Vite. Use um projeto Sentry SEPARADO do backend, nao o
# mesmo SENTRY_DSN acima: mantem erros de browser e de server em projetos
# distintos e nao soma cota. Ausente: o Sentry do client vira no-op.
# Producao (Vercel): configurar no dashboard, pois nao vive neste repo.
VITE_SENTRY_DSN=
# Release opcional do client (ex.: SHA do commit do build). Vazio: sem versao.
VITE_SENTRY_RELEASE=

# Aba Bugs & Erros do admin
# API REST do Sentry (leitura de issues). Token org-scoped ou user token com
# escopo event:read/org:read. Qualquer uma das tres ausente: o endpoint de
# issues responde 503 sentry_not_configured, o bug tracker manual segue normal.
SENTRY_AUTH_TOKEN=
SENTRY_ORG_SLUG=
SENTRY_PROJECT_SLUG=
# Destinos das notificacoes do bug tracker. Vazios: nao envia, so loga.
BUG_NOTIFY_NEW_EMAIL=
BUG_NOTIFY_DONE_EMAIL=
