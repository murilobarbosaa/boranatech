supabase/.temp/
supabase/.branches/

# Local DB content backups (never commit)
backups/

# Bundle analysis (ANALYZE=1 pnpm build)
bundle-stats.html

# PDF cru de perfil do LinkedIn usado nas auditorias: dado pessoal real,
